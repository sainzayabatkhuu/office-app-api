# Environment for `docker compose` (copied to .env by `make up`).
# Every value below matches the default in docker-compose.yml, so an empty .env also works.
# Change the passwords for any shared or production environment. Never commit .env.

# MySQL
DB_USERNAME=office
DB_PASSWORD=office
MYSQL_ROOT_PASSWORD=root

# RabbitMQ
RABBITMQ_USERNAME=office
RABBITMQ_PASSWORD=office

# Grafana admin password
GRAFANA_PASSWORD=admin

# Frontend origins allowed by CORS (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://localhost:3000

# JWT signing keys (identity-service). ./keys is mounted at /keys; `make keys` creates them.
# Leave both empty to use an ephemeral key pair: every restart then logs all users out.
JWT_PRIVATE_KEY_LOCATION=file:/keys/jwt-private.pem
JWT_PUBLIC_KEY_LOCATION=file:/keys/jwt-public.pem
